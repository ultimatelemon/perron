# Subscription key from https://apiportal.ns.nl (product "Ns-App"). Required.
NS_API_KEY=

PORT=3000
# Mount path when a proxy forwards a sub-path unchanged, e.g. /ns. Empty serves /mcp.
BASE_PATH=
# Without it, the cache lives in process memory.
REDIS_URL=
# Icon clients show for this server (https URL or data: URI). Empty uses the built-in one.
ICON_URL=
# Seconds to reuse the nationwide shared-vehicle download (15-600).
VEHICLES_CACHE_SECONDS=60
# Where the GVB timetable (SQLite, rebuilt daily from a 230 MB GTFS download) and the geocode cache live.
DATA_DIR=./data
# GTFS agency and lines for ov_departures. Empty OV_LINES keeps every metro and ferry line of the agency.
OV_AGENCY=GVB
OV_LINES=
# fatal | error | warn | info | debug | trace
LOG_LEVEL=info
